      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code < 300) {",
              "  const p = pm.response.json();",
              "  if (p.definition && p.id) {",
              "    pm.collectionVariables.set('propositionId', p.id);",
              "    pm.collectionVariables.set('revision', String(p.revision));",
              "    if (p.plans?.length) pm.collectionVariables.set('planId', p.plans[0].id);",
              "  }",
              "}"
