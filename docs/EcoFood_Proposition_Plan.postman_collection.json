{
  "info": {
    "name": "EcoFood Proposition / Plan / Market — SCR-33",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Proposition and Plan each have DRAFT -> PENDING_REVIEW -> APPROVED, reviewed independently. An approved Plan operates only when its Proposition is approved and the effective dates permit it. Select BRAND/ECOSYSTEM_PARTNER SUB_TENANTs from Tenant Directory; countries derive from onboarding. Fetch current revision before every mutation."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{internalJwt}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8081"
    },
    {
      "key": "internalJwt",
      "value": ""
    },
    {
      "key": "propositionId",
      "value": ""
    },
    {
      "key": "planId",
      "value": ""
    },
    {
      "key": "revision",
      "value": "0"
    },
    {
      "key": "productId",
      "value": ""
    },
    {
      "key": "productVersion",
      "value": "1"
