{
  "info": {
    "name": "UC-021 Customer — Submit, QR, Ownership",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Demo using the original Submit caller. No POS entity is created. Set sellerToken, orchestratorId and currency. Submit payload must match the ACTIVE Orchestrator schema. Only Customer claim queues Email; receipt issue/view never sends it."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8081"
    },
    {
      "key": "sellerToken",
      "value": ""
    },
    {
      "key": "customerToken",
      "value": ""
    },
    {
      "key": "orchestratorId",
      "value": ""
    },
    {
      "key": "invoiceId",
      "value": ""
    },
    {
      "key": "currency",
      "value": ""
    },
    {
      "key": "receiptRequestId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Submit transaction + generate Invoice QR",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{sellerToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/sales/{{orchestratorId}}/transactions",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"invoiceNumber\": \"DEMO-{{$timestamp}}\",\n  \"transactionTime\": \"{{$isoTimestamp}}\",\n  \"currency\": \"{{currency}}\",\n  \"totalAmount\": 20,\n  \"items\": [\n    {\n      \"productCode\": \"TEST-PRODUCT\",\n      \"productName\": \"Demo product\",\n      \"quantity\": 1,\n      \"unitPrice\": 20,\n      \"amount\": 20\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Submit accepted\", () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) {",
              "  const invoice = pm.response.json();",
              "  pm.collectionVariables.set(\"invoiceId\", invoice.id);",
              "  const requestId = pm.variables.replaceIn(\"{{$guid}}\");",
              "  pm.collectionVariables.set(\"receiptRequestId\", requestId);",
              "  pm.sendRequest({url: pm.variables.replaceIn(\"{{baseUrl}}\") + \"/api/v1/transactions/\" + invoice.id + \"/customer-receipt\", method:\"POST\",",
              "    header: {\"Authorization\":\"Bearer \" + pm.variables.get(\"sellerToken\"), \"Content-Type\":\"application/json\"}, body:{mode:\"raw\",raw:JSON.stringify({requestId})}},",
              "    (error, response) => {",
              "      pm.test(\"Receipt generated\", () => { pm.expect(error).to.equal(null); pm.expect(response.code).to.equal(200); });",
              "      if (!error && response.code === 200) {",
              "        const receipt = response.json();",
              "        pm.visualizer.set('<h2>Invoice QR</h2><p>No Customer Email is sent before ownership is linked.</p><img width=\"320\" height=\"320\" src=\"data:image/png;base64,{{qr}}\"><p><a target=\"_blank\" rel=\"noopener noreferrer\" href=\"{{url}}\">Open Invoice</a></p><p>Expires: {{expiry}}</p>', {qr:receipt.qrPngBase64,url:receipt.receiptUrl,expiry:receipt.expiresAt});",
              "      }",
              "    });",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Issue/retry QR for an existing Invoice",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{sellerToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/transactions/{{invoiceId}}/customer-receipt",
        "body": {
          "mode": "raw",
          "raw": "{\"requestId\":\"{{receiptRequestId}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 200) { const receipt = pm.response.json(); pm.visualizer.set('<h2>Invoice QR</h2><img width=\"320\" height=\"320\" src=\"data:image/png;base64,{{qr}}\"><p><a target=\"_blank\" rel=\"noopener noreferrer\" href=\"{{url}}\">Open Invoice</a></p>', {qr:receipt.qrPngBase64,url:receipt.receiptUrl}); }"
            ]
          }
        }
      ]
    },
    {
      "name": "3. Customer profile",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{customerToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/v1/customers/me"
      }
    },
    {
      "name": "4. Customer purchase history",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{customerToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/v1/customers/me/invoices?page=0&size=20"
      }
    },
    {
      "name": "5. Customer owned Invoice",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{customerToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/v1/customers/me/invoices/{{invoiceId}}"
      }
    },
    {
      "name": "6. Revoke unclaimed QR",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{sellerToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/v1/transactions/{{invoiceId}}/customer-receipt"
      }
    }
  ]
}
