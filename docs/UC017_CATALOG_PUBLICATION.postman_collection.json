      "name": "08 - Cấp hoặc xoay credential Partner",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/v1/catalog-publications/{{publicationId}}/partners",
        "description": "Credential trả về đúng một lần. Sao chép NGUYÊN giá trị credential (đã có tiền tố Catalog) vào biến environment secret externalCatalogCredential. Không lưu vào collection được export hoặc console. Gọi request 05 sau bước này để lấy revision mới.",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"revision\": {{publicationRevision}},\n  \"partnerId\": \"{{ecosystemPartnerId}}\",\n  \"planIds\": [\n    \"{{planId}}\"\n  ],\n  \"expiresAt\": \"{{credentialExpiresAt}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
