    {
      "name": "04 - Save Draft",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/v1/catalog-publications",
        "description": "Chọn propositionId/planId từ request 03 và Partner phù hợp từ options. Chỉ metadata Publication được tạo, không sửa nguồn Product/Plan.",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"apiKey\": \"{{apiKey}}\",\n  \"name\": \"Catalog API\",\n  \"catalogType\": \"{{catalogType}}\",\n  \"version\": {{apiVersion}},\n  \"selections\": [\n    {\n      \"propositionId\": \"{{propositionId}}\",\n      \"planId\": \"{{planId}}\"\n    }\n  ],\n  \"partnerIds\": [\n    \"{{ecosystemPartnerId}}\"\n  ],\n  \"policy\": {\n    \"startsAt\": \"{{policyStartsAt}}\",\n    \"expiresAt\": \"{{policyExpiresAt}}\",\n    \"maxPageSize\": 20\n  },\n  \"customField\": []\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('policyStartsAt', new Date(Date.now() - 60000).toISOString());",
              "pm.collectionVariables.set('policyExpiresAt', new Date(Date.now() + 30 * 86400000).toISOString());",
              "pm.collectionVariables.set('credentialExpiresAt', new Date(Date.now() + 7 * 86400000).toISOString());"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code >= 200 && pm.response.code < 300) {",
              "  const data = pm.response.json();",
              "  if (data.id && data.revision !== undefined) {",
              "    pm.collectionVariables.set('publicationId', data.id);",
              "    pm.collectionVariables.set('publicationRevision', data.revision);",
              "  }",
              "}"
            ]
          }
        }
      ]
    },
