{
  "info": {
    "name": "EcoFood UC-017 – Publish External API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Dùng nguồn Product/Plan thật. Điền internalAccessToken và quyền CATALOG_API_READ/MANAGE/PUBLISH/GRANT phù hợp. Lấy Plan/Partner từ options; Partner phải đã được phân phối Plan. Credential External không phải Internal JWT. Chỉ localhost cho phép HTTP; môi trường khác dùng HTTPS. Biến token/credential nên đặt ở Postman environment kiểu secret và không export giá trị thật. Collection không tự lưu hoặc log raw credential."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{internalAccessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8081",
      "type": "string"
    },
    {
      "key": "internalAccessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "publicationId",
      "value": "",
      "type": "string"
    },
    {
      "key": "publicationRevision",
      "value": "1",
      "type": "string"
    },
    {
      "key": "apiKey",
      "value": "food-catalog",
      "type": "string"
    },
    {
      "key": "apiVersion",
      "value": "1",
      "type": "string"
    },
    {
      "key": "catalogType",
      "value": "PRODUCT",
      "type": "string"
    },
    {
      "key": "propositionId",
      "value": "",
      "type": "string"
    },
    {
      "key": "planId",
      "value": "",
      "type": "string"
    },
    {
      "key": "ecosystemPartnerId",
      "value": "",
      "type": "string"
    },
    {
      "key": "policyStartsAt",
      "value": "",
      "type": "string"
    },
    {
      "key": "policyExpiresAt",
      "value": "",
      "type": "string"
    },
    {
      "key": "credentialExpiresAt",
      "value": "",
      "type": "string"
    },
    {
      "key": "externalCatalogCredential",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 - Kiểm tra quyền Employee",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/catalog-publications/capabilities",
        "description": "",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code >= 200 && pm.response.code < 300) {",
              "  const data = pm.response.json();",
              "  if (data.id && data.revision !== undefined) {",
              "    pm.collectionVariables.set('publicationId', data.id);",
              "    pm.collectionVariables.set('publicationRevision', data.revision);",
              "  }",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "02 - Catalog và Partner options",
